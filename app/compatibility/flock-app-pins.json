  "merge": {
    "pins": {
      "car": { "id": "11111111", "from": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "kind": "car", "geohash": "u0edj70", "precision": 7, "timestamp": 10 },
      "carMoved": { "id": "11111111", "from": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "kind": "car", "geohash": "u0edj71", "precision": 7, "timestamp": 20 },
      "other": { "id": "22222222", "from": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "kind": "water", "geohash": "u0edj72", "precision": 7, "timestamp": 5 },
      "tomb": { "id": "11111111", "from": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "kind": "car", "geohash": "u0edj70", "precision": 7, "timestamp": 30, "removed": true },
      "staleDrop": { "id": "11111111", "from": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "kind": "car", "geohash": "zzzz", "precision": 7, "timestamp": 1 },
      "tombByOther": { "id": "11111111", "from": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "kind": "car", "geohash": "u0edj70", "precision": 7, "timestamp": 30, "removed": true },
      "reDrop": { "id": "11111111", "from": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "kind": "car", "geohash": "u0edj7z", "precision": 7, "timestamp": 40 }
    },
    "cases": [
      {
        "name": "basic merge of two distinct ids builds a 2-entry list",
        "sequence": ["car", "other"],
        "expectedLength": 2
      },
      {
        "name": "a newer drop of the same id replaces it",
        "sequence": ["car", "other", "carMoved"],
        "expectedFindId": "11111111",
        "expectedGeohash": "u0edj71"
      },
      {
        "name": "an older drop of the same id is ignored (same list reference returned)",
        "startSequence": ["carMoved", "other"],
        "incoming": "staleDrop",
        "expectSameRef": true
      },
      {
        "name": "a tombstone is retained as an entry, not dropped, and outranks the drop",
        "startSequence": ["carMoved", "other"],
        "incoming": "tomb",
        "expectedLength": 2,
        "expectedFindId": "11111111",
        "expectedRemoved": true
      },
      {
        "name": "a replayed drop after its tombstone never resurrects the pin",
        "sequence": ["car", "tomb", "car"],
        "expectedFindId": "11111111",
        "expectedRemoved": true
      },
      {
        "name": "a tombstone that arrives before its drop is never forgotten (drop never resurrects it)",
        "sequence": ["tomb", "car"],
        "expectedFindId": "11111111",
        "expectedRemoved": true
      },
      {
        "name": "a genuinely newer re-drop after a tombstone does land (un-removes with new state)",
        "sequence": ["car", "tomb", "reDrop"],
        "expectedFindId": "11111111",
        "expectedRemoved": false,
        "expectedGeohash": "u0edj7z"
      },
      {
        "name": "another member's tombstone lands on the pin — removal is by id, signed as the remover, not the dropper",
        "sequence": ["car", "tombByOther"],
        "expectedFindId": "11111111",
        "expectedRemoved": true,
        "expectedFrom": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      {
        "name": "the original dropper's drop replaying after another member's tombstone still loses",
        "sequence": ["car", "tombByOther", "car"],
        "expectedFindId": "11111111",
        "expectedRemoved": true,
        "expectedFrom": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      }
    ]
