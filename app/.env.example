# Public build-time settings: VITE_* values are included in the client bundle.
# Never put credentials or identity/pairing secrets here.
# Comma-separated; replaces the built-in defaults (relay.damus.io, nos.lol, relay.primal.net).
VITE_DEFAULT_RELAY=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors
