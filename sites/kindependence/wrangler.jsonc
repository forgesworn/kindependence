{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Static one-page site, served from Workers static assets.
  "name": "kindependence-site",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "kindependence.app", "custom_domain": true },
    { "pattern": "www.kindependence.app", "custom_domain": true }
  ],
  "workers_dev": false
}
